#!/usr/bin/env bash

# simonw/llm shim. Runs the latest llm from PyPI through uv (uvx / uv tool run).
# Models are configured in ~/.config/io.datasette.llm by modules/llm.
#
# `uvx` and `uv` are often shadowed by other shims (mise symlinks them to
# itself, for example), which then misparse `--from`. So every candidate must
# prove it is really uv before it gets our arguments.

set -u

# is_uv <path>: true when <path> --version reports a uv release.
is_uv() {
	local out
	out="$("$1" --version 2>/dev/null | head -n 1)" || return 1
	case "$out" in
	"uv "*) return 0 ;;
	"uvx "*) return 0 ;;
	esac
	return 1
}

for candidate in uvx uv; do
	bin="$(command -v "$candidate" 2>/dev/null)" || continue
	is_uv "$bin" || continue
	case "$candidate" in
	uvx) exec "$bin" --from llm llm "$@" ;;
	uv) exec "$bin" tool run --from llm llm "$@" ;;
	esac
done

# Fall back to whatever uv mise knows about, bypassing its misbehaving shims.
if command -v mise >/dev/null 2>&1; then
	bin="$(mise which uv 2>/dev/null)" || bin=""
	if [ -n "$bin" ] && [ -x "$bin" ] && is_uv "$bin"; then
		exec "$bin" tool run --from llm llm "$@"
	fi
fi

echo "llm shim: no working uv/uvx found on PATH" >&2
exit 127
